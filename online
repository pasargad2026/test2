<div id="toastMsg" class="toast-message">✅ درخواست شما با موفقیت ثبت شد، کارشناسان تماس می‌گیرند.</div>

<script>
    // موبایل منو
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const navLinks = document.getElementById('navLinks');
    mobileBtn.addEventListener('click', () => {
        navLinks.classList.toggle('active');
    });

    // smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            const targetId = this.getAttribute('href');
            if (targetId === "#") return;
            const targetElem = document.querySelector(targetId);
            if (targetElem) {
                e.preventDefault();
                targetElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
                // بستن منو موبایل در صورت باز بودن
                if (navLinks.classList.contains('active')) {
                    navLinks.classList.remove('active');
                }
            }
        });
    });

    // نمایش toast
    function showToast(message) {
        const toast = document.getElementById('toastMsg');
        toast.textContent = message || "✅ درخواست شما با موفقیت ثبت شد، کارشناسان تماس می‌گیرند.";
        toast.classList.add('show');
        setTimeout(() => {
            toast.classList.remove('show');
        }, 4000);
    }

    // مدیریت فرم مشاوره
    const consultForm = document.getElementById('consultForm');
    consultForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const fullname = document.getElementById('fullname').value.trim();
        const phone = document.getElementById('phone').value.trim();
        if (!fullname || !phone) {
            showToast("⚠️ لطفاً نام و شماره تماس را وارد کنید.");
            return;
        }
        const planSelect = document.getElementById('planType');
        const selectedPlan = planSelect.value;
        // ذخیره در کنسول یا ارسال به سرور (شبیه‌سازی ذخیره)
        console.log({
            fullname,
            phone,
            plan: selectedPlan,
            message: document.getElementById('message').value
        });
        // نمایش پیام موفقیت
        showToast("✅ درخواست مشاوره شما ثبت شد! به زودی با شما تماس می‌گیریم.");
        consultForm.reset();
        // scroll به بالای صفحه یا باقی ماندن
    });
    
    //اضافه کردن قابلیت کلیک روی کارت‌های بیمه برای پیام مستقیم (اختیاری)
    const planCards = document.querySelectorAll('.plan-card .btn-outline, .plan-card .btn-primary');
    planCards.forEach(btn => {
        btn.addEventListener('click', function(ev) {
            ev.preventDefault();
            const consultSection = document.querySelector('#consult');
            if(consultSection) consultSection.scrollIntoView({ behavior: 'smooth' });
            showToast("👈 لطفاً فرم مشاوره را تکمیل کنید تا کارشناسان بهترین طرح را به شما پیشنهاد دهند.");
        });
    });
    
    // تغییر تصویر placeholder در صورت عدم لود (برای نمایش بهتر)
    const heroImg = document.querySelector('.hero-image img');
    if(heroImg && heroImg.src.includes('placehold.co')) {
        heroImg.alt = "مشاوره بیمه عمر حرفه‌ای";
    }
</script>
